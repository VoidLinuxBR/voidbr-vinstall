# Lista as versões de kernel órfãs com a mesma varredura do
# findOrphanVersions() do voidbr-vkpurge (>= 0.7.27): vmlinuz, vmlinux,
# initramfs e config em /boot, mais os diretórios de /usr/lib/modules.
# Exclui o kernel em execução, os kernels que ainda pertencem a pacotes
# instalados (via xbps-query) e nomes que o isValidKernelVersion()
# recusaria.
#   $1 = installed -> inclui também os kernels instalados (para o `rm`,
#                     que oferece desinstalar o pacote); o padrão é só órfãos.
_voidbr_vkpurge_kernels() {
	local with_installed=0
	[[ $1 == installed ]] && with_installed=1
	local running f k p globopts
	local -A seen=() installed=()

	# Não depende de nullglob/failglob do usuário
	globopts=$(shopt -p nullglob failglob)
	shopt -s nullglob
	shopt -u failglob

	running=$(uname -r 2>/dev/null)

	if ((!with_installed)) && command -v xbps-query >/dev/null 2>&1; then
		while read -r f; do
			[[ $f =~ vmlinu[xz]-([^[:space:]]+) ]] && installed[${BASH_REMATCH[1]}]=1
		done < <(xbps-query -o '/boot/vmlinu[xz]-*' 2>/dev/null)
	fi

	for f in /boot/vmlinuz-* /boot/vmlinux-* /boot/initramfs-* /boot/config-* /usr/lib/modules/*/; do
		f=${f%/}
		k=${f##*/}
		if [[ $f == /boot/* ]]; then
			# a versão é o que vem depois do prefixo (pode ter hífen)
			for p in vmlinuz- vmlinux- initramfs- config-; do
				[[ $k == "$p"* ]] && { k=${k#"$p"}; break; }
			done
			[[ $f == /boot/initramfs-* ]] && k=${k%.img}
		fi
		[[ $k =~ ^[A-Za-z0-9._+-]+$ && $k != *..* ]] || continue
		[[ $k == "$running" ]] && continue
		[[ -n ${installed[$k]} ]] && continue
		seen[$k]=1
	done

	eval "$globopts"
	printf '%s\n' "${!seen[@]}"
}

_voidbr_vkpurge() {
	local cur prev i word
	local cmd="" target=0 cleanup=0 keep=0 force=0 dryrun=0 yes=0 nosnap=0
	local -a opts=() mods=()

	COMPREPLY=()
	cur=${COMP_WORDS[COMP_CWORD]}
	prev=${COMP_WORDS[COMP_CWORD - 1]}

	# Analisa o que já foi digitado do mesmo jeito que o main() do Go:
	# a palavra logo após list/rm (se não começar com "-") é o alvo,
	# mesmo que seja "list" ou "rm"; a palavra após --keep é o número.
	for ((i = 1; i < COMP_CWORD; i++)); do
		word=${COMP_WORDS[i]}
		case $word in
			list | rm)
				cmd=$word
				if ((i + 1 < COMP_CWORD)) && [[ ${COMP_WORDS[i + 1]} != -* ]]; then
					target=1
					((i++))
				fi
				;;
			status) cmd=status ;;
			--keep)
				keep=1
				((i + 1 < COMP_CWORD)) && ((i++))
				;;
			--keep=*) keep=1 ;;
			--cleanup) cleanup=1 ;;
			--force) force=1 ;;
			--dry-run) dryrun=1 ;;
			-y | --yes) yes=1 ;;
			--no-snapshot) nosnap=1 ;;
			-h | --help) return 0 ;;
		esac
	done

	# Número depois de --keep
	if [[ $prev == --keep ]]; then
		COMPREPLY=($(compgen -W "1 2 3" -- "$cur"))
		return 0
	fi

	# Alvo logo após `rm` ou `list`
	if [[ $cur != -* && -n $cmd && $cmd != status && $target -eq 0 && $prev == "$cmd" ]]; then
		case $cmd in
			rm) COMPREPLY=($(compgen -W "all $(_voidbr_vkpurge_kernels installed)" -- "$cur")) ;;
			list) COMPREPLY=($(compgen -W "$(_voidbr_vkpurge_kernels)" -- "$cur")) ;;
		esac
		return 0
	fi

	# Modificadores das operações que removem algo, ainda não usados
	((dryrun)) || mods+=(--dry-run)
	((yes)) || mods+=(-y --yes)
	((nosnap)) || mods+=(--no-snapshot)

	# Só um modo por vez: list, rm, status, --cleanup, --keep
	if ((cleanup)); then
		((force)) || opts+=(--force)
		opts+=("${mods[@]}")
	elif ((keep)) || [[ $cmd == rm ]]; then
		opts+=("${mods[@]}")
	elif [[ -n $cmd ]]; then
		# list e status não têm modificadores
		:
	elif ((force)); then
		# --force só tem efeito junto com --cleanup
		opts+=(--cleanup "${mods[@]}")
	elif ((dryrun || yes || nosnap)); then
		# modificadores só valem para rm, --cleanup e --keep
		opts+=(rm --cleanup --keep --force "${mods[@]}")
	else
		opts+=(status list rm --cleanup --keep --force "${mods[@]}" --help)
	fi

	COMPREPLY=($(compgen -W "${opts[*]}" -- "$cur"))
	return 0
}

complete -F _voidbr_vkpurge voidbr-vkpurge
